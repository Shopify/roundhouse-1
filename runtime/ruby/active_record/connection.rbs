# Typing contract for the raw-SQL connection facade. Rows are
# Hash[String, untyped] by design — raw SQL's row shape (aliased
# aggregates, computed columns) is genuinely dynamic; see connection.rb.
module ActiveRecord
  class IntegerKeyCast
    @valid: bool
    @value: Integer
    def valid: () -> bool
    def value: () -> Integer
    def initialize: (bool valid, Integer value) -> void
    def self.input_text: (Integer | Float | String | nil id) -> String
    def self.parse: (Integer | Float | String | nil id) -> ::ActiveRecord::IntegerKeyCast
    def self.number_start: (String text) -> Integer
    def self.digit_value: (String char) -> Integer
    def self.exceeds_limit: (String digits, String limit) -> bool
  end

  class Result
    @rows: Array[Hash[String, untyped]]

    def initialize: (Array[Hash[String, untyped]] rows) -> void
    def rows: () -> Array[Hash[String, untyped]]
    def to_a: () -> Array[Hash[String, untyped]]
    def first: () -> Hash[String, untyped]?
    def each: () { (Hash[String, untyped]) -> void } -> Array[Hash[String, untyped]]
  end

  class Connection
    def adapter_name: () -> String
    def quote: (String | Symbol | Integer | Float | bool | nil value) -> String
    def quote_string: (String str) -> String
    def execute: (String sql) -> Result
    def select_rows: (String sql) -> Array[Array[untyped]]
    def select_values: (String sql, ?String? name) -> Array[untyped]
    def select_value: (String sql, ?String? name) -> untyped
    def exec_query: (String sql) -> Result
    def select_all: (String sql) -> Result
    def exec_update: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Integer
    def exec_delete: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Integer
    def exec_insert: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Result
  end

  class Base
    @__pending_preload: PendingPreload?
    self.@__declared_attribute_types: Hash[String, [Symbol | ActiveModel::Type::Value, Hash[Symbol, untyped]]]?
    def _pend_preload: (PendingPreload pending) -> nil
    def _await_preload: () -> nil
    # Request values stay intact until the schema-selected scalar adapter.
    def self.find: (Integer | Float | String | nil id) -> Base
    def self._find_primary_key_input: (Integer | Float | String | nil id) -> Base?
    def self._find_composite_primary_key: (untyped id) -> untyped
    def self.composite_primary_key?: () -> bool
    def self._cast_primary_key: (Integer | Float | String | nil id) -> (Integer | String | nil)
    def self.connection: () -> Connection
    def self.sanitize_sql: (Array[untyped] statement) -> String
    def self.sanitize_sql_array: (Array[untyped] statement) -> String
    def self.transaction: () { () -> untyped } -> untyped
    def self.update_counters: (Integer | String id, Hash[Symbol, untyped] counters) -> Integer
    def self.upsert: (Hash[Symbol, untyped] attrs, ?unique_by: (String | Symbol | Array[Symbol]), ?on_duplicate: String?, ?returning: untyped) -> Integer
    def self._conflict_predicate: (String columns) -> String
    def self.upsert_all: (Array[Hash[Symbol, untyped]] rows, ?unique_by: (String | Symbol | Array[Symbol]), ?on_duplicate: String?, ?returning: untyped) -> Integer
    def self.record_timestamps=: (bool value) -> bool
    def self.record_timestamps: () -> bool
    def self.abstract_class: () -> bool?
    def self.abstract_class=: (bool? value) -> bool?
    def self.abstract_class?: () -> bool
    def self.schema_column_types: () -> Hash[String, Array[(Symbol | Integer | String)?]]
    def self.type_for_attribute: (String | Symbol attribute_name) ?{ (String) -> ActiveModel::Type::Value } -> ActiveModel::Type::Value
    def self.attribute_types: () -> Hash[String, ActiveModel::Type::Value]
    def self._cast_column: (String name, untyped value) -> untyped
    def self._cast_type_for_spec: (String name, Array[(Symbol | Integer | String)?] spec) -> ActiveModel::Type::Value
    def self.attribute: (String | Symbol name, ?untyped type, ?default: untyped, **untyped options) -> nil
    def self.serialize: (String | Symbol attr_name, ?coder: untyped, ?type: untyped, ?comparable: bool, ?yaml: Hash[Symbol, untyped], **untyped options) -> nil
    def self._retypable_attribute_names: () -> Array[String]
    def self._defaulted_attribute_names: () -> Array[String]
    def self._declared_attribute_defaults: () -> Hash[String, untyped]
    def self._attribute_default?: (String name) -> bool
    def self._attribute_default: (String name) -> untyped
    def self.alias_attribute: (Symbol | String new_name, Symbol | String old_name) -> nil
    def self.attribute_aliases: () -> Hash[String, String]
    def self.attribute_alias?: (Symbol | String name) -> bool
    def self.attribute_alias: (Symbol | String name) -> String?
    def self._attribute_name: (String name) -> String
    def self._resolve_attribute_aliases: (Hash[Symbol, untyped] attrs) -> Hash[Symbol, untyped]
    def self.query_constraints: (*(String | Symbol) columns_list) -> Array[String]
    def self.has_query_constraints?: () -> Array[String]?
    def self.query_constraints_list: () -> Array[String]?
    def self.composite_query_constraints_list: () -> Array[String]
    def self._compiled_query_constraints: () -> Array[String]?
    def self.ignored_columns: () -> Array[String]
    def self.ignored_columns=: (Array[String | Symbol] columns) -> Array[String]
    def self._compiled_ignored_columns: () -> Array[String]
    def self._declared_attribute_types: () -> Hash[String, untyped]
    def self._reset_attribute_types: () -> nil
    def self._attribute_cast: (String name, untyped value) -> untyped
    def self._attribute_force_equality?: (String name, untyped value) -> bool
    def self._attribute_deserialize: (String name, untyped value) -> untyped
    def self._bind_type_cast: (String name, untyped value) -> untyped
    def self._bind_bool_text: (bool flag) -> String
    def self._attribute_serialize: (String name, untyped value) -> untyped
    def self._attribute_for_database: (String name, untyped value) -> untyped
    def self._primary_key_from_database: (untyped value) -> untyped
    def update_column: (String | Symbol name, untyped value) -> bool
    def _as_json_only: (Array[Symbol] only) -> Hash[String, untyped]
    # Nil and uncastable request keys reject before the scalar adapter.
    def self.exists?: (?(Integer | Float | String | nil) id) -> bool
    def self._exists_primary_key_input: (Integer | Float | String | nil id) -> bool
    # Ruby-family overrides of base.rb's Array / COUNT fallbacks.
    def self.where: (Hash[Symbol, untyped] conditions) -> Relation
    def self.find_by: (Hash[String | Symbol, untyped] conditions) -> Base?
    def self.all: () -> Relation
    # default_scope (`lower::default_scope` emits the declaring model's).
    self.@_unscoped_depth: Integer?
    def self._default_scoped?: () -> bool
    def self._apply_default_scope: (Relation relation) -> Relation
    def self._default_scope_attributes: () -> Hash[Symbol, untyped]
    def self._default_scope_applies?: () -> bool
    def self.unscoped: () ?{ () -> untyped } -> untyped
    def _seed_default_scope_attributes: (Hash[Symbol, untyped] attrs) -> void
    def self.count: () -> Integer
    def self.last: () -> Base?
    def self.destroy_all: () -> Array[Base]
    def self.none: () -> Relation
    def self.page: (?(Integer | String | nil) num) -> Relation
    def self.paginate: (?(Integer | String | nil) num, ?page: (Integer | String | nil), ?per_page: (Integer | String | nil)) -> Relation
    def self.any?: () -> bool
    def self.none?: () -> bool
    def _attribute_snapshot: () -> Hash[String, untyped]
    def _note_hydrated: () -> void
    def _note_unloaded: (Hash[String, untyped] row) -> nil
    def has_attribute?: (Symbol name) -> bool
    def attribute_previously_was: (String name) -> untyped
    def self.first: () -> Base?
    def self.take: () -> Base?
    def self._hydrate_all: (String sql) -> Array[Base]
    def update_attribute: (Symbol name, untyped value) -> bool
    def valid?: (?Symbol? context) -> bool
    def validation_context: () -> Symbol?
    def save: (?context: Symbol?) -> bool
    def save!: (?context: Symbol?) -> Base
    # Ruby-family overrides of base.rb's dirty-tracking stubs.
    def __track_saved_changes: (bool was_new) -> void
    def saved_changes: () -> Hash[String, untyped]
    def changes_to_save: () -> Hash[String, untyped]
    def attribute_was: (String name) -> untyped
  end
end
