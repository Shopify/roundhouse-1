# Typing contract for the raw-SQL connection facade. Rows are
# Hash[String, untyped] by design — raw SQL's row shape (aliased
# aggregates, computed columns) is genuinely dynamic; see connection.rb.
module ActiveRecord
  module Scoping
    # The current and global scopes per model name. A scope is whatever
    # `scoping` was handed (a Relation), so it stays untyped.
    class ScopeRegistry
      @current_scope: Hash[String, untyped]
      @global_current_scope: Hash[String, untyped]

      def self.instance: () -> ScopeRegistry
      def self.current_scope: (untyped model, ?bool skip_inherited_scope) -> untyped
      def self.set_current_scope: (untyped model, untyped value) -> untyped
      def self.global_current_scope: (untyped model, ?bool skip_inherited_scope) -> untyped
      def self.set_global_current_scope: (untyped model, untyped value) -> untyped
      def initialize: () -> void
      def current_scope: (untyped model, ?bool skip_inherited_scope) -> untyped
      def set_current_scope: (untyped model, untyped value) -> untyped
      def global_current_scope: (untyped model, ?bool skip_inherited_scope) -> untyped
      def set_global_current_scope: (untyped model, untyped value) -> untyped
      def value_for: (Hash[String, untyped] scope_type, untyped model, bool skip_inherited_scope) -> untyped
    end
  end

  module AttributeMethods
    module TimeZoneConversion
      # time_zone_conversion.rb's TimeZoneConverter over a SimpleDelegator:
      # the subtype's value is what every method here wraps, so each
      # answer is the delegated type's own (untyped).
      class TimeZoneConverter
        def self.new: (untyped subtype) -> untyped
        def subtype: () -> untyped
        # The delegated Type::Value's own methods (SimpleDelegator's
        # `__getobj__` and the wrapped type's `type` / `map`).
        %a{abstract}
        def __getobj__: () -> untyped
        %a{abstract}
        def type: () -> untyped
        %a{abstract}
        def map: (untyped value) { (untyped) -> untyped } -> untyped
        def deserialize: (untyped value) -> untyped
        def cast: (untyped value) -> untyped
        def ==: (untyped other) -> bool
        def convert_time_to_time_zone: (untyped value) -> untyped
        def set_time_zone_without_conversion: (untyped value) -> untyped
      end
    end
  end

  class NamedAttributeDecoration
    @name: String
    @decorator: untyped
    def initialize: (String name, untyped decorator) -> void
    def call: (untyped cast_type) -> untyped
  end

  module TransactionHooks
    def self.began: () -> nil
    def self.committed: () -> nil
    def self.rolled_back: () -> nil
  end

  class IntegerKeyCast
    @valid: bool
    @value: Integer
    def valid: () -> bool
    def value: () -> Integer
    def initialize: (bool valid, Integer value) -> void
    def self.input_text: (Integer | Float | String | nil id) -> String
    def self.parse: (Integer | Float | String | nil id) -> ::ActiveRecord::IntegerKeyCast
    def self.number_start: (String text) -> Integer
    def self.digit_value: (String char) -> Integer
    def self.exceeds_limit: (String digits, String limit) -> bool
  end

  class Result
    @columns: Array[String]
    @rows: Array[Array[untyped]]
    @hash_rows: Array[Hash[String, untyped]]?
    @column_types: untyped
    @types_hash: Hash[String | Integer, untyped]?
    @affected_rows: Integer?

    def self.from_hashes: (Array[Hash[String, untyped]] hashes, ?affected_rows: Integer?) -> Result
    def initialize: (Array[String] columns, Array[Array[untyped]] rows, ?untyped column_types, ?affected_rows: Integer?) -> void
    def columns: () -> Array[String]
    def rows: () -> Array[Array[untyped]]
    def affected_rows: () -> Integer?
    def includes_column?: (String name) -> bool
    def length: () -> Integer
    def each: () { (Hash[String, untyped]) -> void } -> Array[Hash[String, untyped]]
    def empty?: () -> bool
    def to_ary: () -> Array[Hash[String, untyped]]
    def to_a: () -> Array[Hash[String, untyped]]
    def []: (Integer idx) -> Hash[String, untyped]?
    def first: (?Integer? n) -> (Hash[String, untyped] | Array[Hash[String, untyped]])?
    def last: (?Integer? n) -> (Hash[String, untyped] | Array[Hash[String, untyped]])?
    def hash_rows: () -> Array[Hash[String, untyped]]
    def column_types: () -> Hash[String | Integer, untyped]
    def result: () -> Result
  end

  class RawConnection
    def transaction: (?Symbol mode) { () -> untyped } -> untyped
  end

  class Connection
    def adapter_name: () -> String
    def transaction_open?: () -> bool
    def quote: (String | Symbol | Integer | Float | bool | nil value) -> String
    def quote_string: (String str) -> String
    def execute: (String sql) -> Result
    def select_rows: (String sql) -> Array[Array[untyped]]
    def select_values: (String sql, ?String? name) -> Array[untyped]
    def select_value: (String sql, ?String? name) -> untyped
    def data_source_exists?: (String | Symbol name) -> bool
    def column_exists?: (String | Symbol table, String | Symbol column) -> bool
    def raw_connection: () -> RawConnection
    def exec_query: (String sql) -> Result
    def select_all: (String sql) -> Result
    def exec_update: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Integer
    def exec_delete: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Integer
    def exec_insert: (String sql, ?String? name, ?Array[String | Integer | Float | bool | nil] binds) -> Result
  end

  class Base
    @__pending_preload: PendingPreload?
    self.@__declared_attribute_types: Hash[String, [Symbol | ActiveModel::Type::Value, Hash[Symbol, untyped]]]?
    def _pend_preload: (PendingPreload pending) -> nil
    def _await_preload: () -> nil
    # Request values stay intact until the schema-selected scalar adapter.
    def self.find: (Integer | Float | String | nil id) -> Base
    def self.find_by!: (Hash[String | Symbol, untyped] conditions) -> Base
    def self._find_primary_key_input: (Integer | Float | String | nil id) -> Base?
    def self._find_composite_primary_key: (untyped id) -> untyped
    def self.composite_primary_key?: () -> bool
    def self._cast_primary_key: (Integer | Float | String | nil id) -> (Integer | String | nil)
    def self.connection: () -> Connection
    def self.sanitize_sql: (Array[untyped] statement) -> String
    def self.sanitize_sql_array: (Array[untyped] statement) -> String
    def self.uncached: () { () -> untyped } -> untyped
    def self.sanitize_sql_like: (String string, ?String escape_character) -> String
    def self.clear_query_caches_for_current_thread: () -> nil
    def self.transaction: (?isolation: untyped, ?requires_new: untyped, ?joinable: bool) { () -> untyped } -> untyped
    def with_lock: (?(bool | String)? lock, ?isolation: untyped, ?requires_new: untyped, ?joinable: bool) { () -> untyped } -> untyped
    def self.delete_all: () -> Integer
    def self.update_counters: (Integer | String id, Hash[Symbol, untyped] counters) -> Integer
    def self.upsert: (Hash[Symbol, untyped] attrs, ?unique_by: (String | Symbol | Array[Symbol]), ?on_duplicate: String?, ?update_only: (String | Symbol | Array[Symbol | String])?, ?returning: untyped) -> Integer
    def self._conflict_predicate: (String columns) -> String
    def self.upsert_all: (Array[Hash[Symbol, untyped]] rows, ?unique_by: (String | Symbol | Array[Symbol]), ?on_duplicate: String?, ?update_only: (String | Symbol | Array[Symbol | String])?, ?returning: untyped) -> Integer
    def self.insert_all: (Array[Hash[Symbol, untyped]] rows, ?unique_by: (String | Symbol | Array[Symbol])?, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def self.insert_all!: (Array[Hash[Symbol, untyped]] rows, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def self.insert: (Hash[Symbol, untyped] attrs, ?unique_by: (String | Symbol | Array[Symbol])?, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def self.insert!: (Hash[Symbol, untyped] attrs, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def self._insert_rows: (Array[Hash[Symbol, untyped]] rows, bool skip_conflicts, (String | Symbol | Array[Symbol])? unique_by, untyped returning, bool? record_timestamps) -> Integer
    def self._upsert_rows: (Array[Hash[Symbol, untyped]] rows, (String | Symbol | Array[Symbol])? unique_by, String? on_duplicate, (String | Symbol | Array[Symbol | String])? update_only, untyped returning) -> Integer
    def self.record_timestamps=: (bool value) -> bool
    def self.record_timestamps: () -> bool
    def self.abstract_class: () -> bool?
    def self.abstract_class=: (bool? value) -> bool?
    def self.abstract_class?: () -> bool
    def self.base_class: () -> untyped
    def self.base_class?: () -> bool
    def self.store_full_class_name: () -> bool
    def self.store_full_class_name=: (bool value) -> bool
    def self.store_full_class_name?: () -> bool
    def self.polymorphic_name: () -> String
    def self.polymorphic_class_for: (String name) -> untyped
    def self.store_full_sti_class: () -> bool
    def self.store_full_sti_class=: (bool value) -> bool
    def self.store_full_sti_class?: () -> bool
    def self.sti_class_for: (String type_name) -> untyped
    def self.find_sti_class: (String type_name) -> untyped
    def self._compute_type: (String type_name) -> untyped
    def self.schema_column_types: () -> Hash[String, Array[(Symbol | Integer | String)?]]
    def self.type_for_attribute: (String | Symbol attribute_name) ?{ (String) -> ActiveModel::Type::Value } -> ActiveModel::Type::Value
    def self.attribute_types: () -> Hash[String, ActiveModel::Type::Value]
    def self.column_defaults: () -> Hash[String, untyped]
    def self._cast_column: (String name, untyped value) -> untyped
    def self._cast_type_for_spec: (String name, Array[(Symbol | Integer | String)?] spec) -> ActiveModel::Type::Value
    def self.attribute: (String | Symbol name, ?untyped type, ?default: untyped, **untyped options) -> nil
    def self.serialize: (String | Symbol attr_name, ?coder: untyped, ?type: untyped, ?comparable: bool, ?yaml: Hash[Symbol, untyped], **untyped options) -> nil
    def self.decorate_attributes: (?untyped names) { (String, untyped) -> untyped } -> nil
    def self._decorate_attribute: (String name, untyped decoration) -> nil
    def self._retypable_attribute_names: () -> Array[String]
    def self._defaulted_attribute_names: () -> Array[String]
    def self._declared_attribute_defaults: () -> Hash[String, untyped]
    def self._attribute_default?: (String name) -> bool
    def self._attribute_default: (String name) -> untyped
    def self.alias_attribute: (Symbol | String new_name, Symbol | String old_name) -> nil
    def self.attribute_aliases: () -> Hash[String, String]
    def self.attribute_alias?: (Symbol | String name) -> bool
    def self.attribute_alias: (Symbol | String name) -> String?
    def self._attribute_name: (String name) -> String
    def self._resolve_attribute_aliases: (Hash[Symbol, untyped] attrs) -> Hash[Symbol, untyped]
    def self.query_constraints: (*(String | Symbol) columns_list) -> Array[String]
    def self.has_query_constraints?: () -> Array[String]?
    def self.query_constraints_list: () -> Array[String]?
    def self.composite_query_constraints_list: () -> Array[String]
    def self._compiled_query_constraints: () -> Array[String]?
    def self.ignored_columns: () -> Array[String]
    def self.ignored_columns=: (Array[String | Symbol] columns) -> Array[String]
    def self._compiled_ignored_columns: () -> Array[String]
    def self._declared_attribute_types: () -> Hash[String, untyped]
    def self._reset_attribute_types: () -> nil
    def self._attribute_cast: (String name, untyped value) -> untyped
    def self._attribute_force_equality?: (String name, untyped value) -> bool
    def self._attribute_deserialize: (String name, untyped value) -> untyped
    def self._bind_type_cast: (String name, untyped value) -> untyped
    def self._bind_bool_text: (bool flag) -> String
    def self._quoted_time: (::Time time) -> String
    def self._attribute_serialize: (String name, untyped value) -> untyped
    def self._attribute_for_database: (String name, untyped value) -> untyped
    def self._primary_key_from_database: (untyped value) -> untyped
    def update_column: (String | Symbol name, untyped value, ?touch: untyped) -> bool
    def update_columns: (Hash[String | Symbol, untyped] attributes) -> bool
    def delete: () -> Base
    def _as_json_only: (Array[Symbol] only) -> Hash[String, untyped]
    # Nil and uncastable request keys reject before the scalar adapter.
    def self.exists?: (?(Integer | Float | String | nil) id) -> bool
    def self._exists_primary_key_input: (Integer | Float | String | nil id) -> bool
    # Ruby-family overrides of base.rb's Array / COUNT fallbacks.
    def self.where: (?(Hash[Symbol, untyped] | String | Array[untyped] | nil) conditions, *untyped args) -> Relation
    def self.find_by: (Hash[String | Symbol, untyped] conditions) -> Base?
    def self.find_sole_by: (Hash[String | Symbol, untyped] conditions) -> Base
    def self.find_or_initialize_by: (Hash[Symbol, untyped] conditions) ?{ (Base) -> void } -> Base
    def self.find_or_create_by: (Hash[Symbol, untyped] conditions) ?{ (Base) -> void } -> Base
    def self.create_or_find_by: (Hash[Symbol, untyped] conditions) ?{ (Base) -> void } -> Base
    def self.create_or_find_by!: (Hash[Symbol, untyped] conditions) ?{ (Base) -> void } -> Base
    def self.find_or_create_by!: (Hash[Symbol, untyped] conditions) ?{ (Base) -> void } -> Base
    def self.sole: () -> Base
    def self.all: () -> Relation
    def self._hook_attribute_type: (untyped name, untyped cast_type) -> untyped
    def self._create_time_zone_conversion_attribute?: (untyped name, untyped cast_type) -> bool
    def self._scoped_reads?: () -> bool
    def self.lock: (?(String | bool)? locks) -> Relation
    def self.unscope: (*untyped args) -> Relation
    def self.create_with: (untyped attrs) -> Relation
    def self.and: (Relation other) -> Relation
    def self.or: (Relation other) -> Relation
    def self.current_scope: (?bool skip_inherited_scope) -> untyped
    def self.current_scope=: (untyped scope) -> untyped
    def self.global_current_scope: (?bool skip_inherited_scope) -> untyped
    def self.global_current_scope=: (untyped scope) -> untyped
    def self.scope_registry: () -> ::ActiveRecord::Scoping::ScopeRegistry
    # Declared by the emitted model or a class-level macro, not by a `def`
    # here: the contract the bodies in connection.rb are typed against.
    %a{abstract}
    def self.columns_hash: () -> Hash[String, untyped]
    %a{abstract}
    def self.inheritance_column: () -> String
    %a{abstract}
    def self.time_zone_aware_attributes: () -> bool
    %a{abstract}
    def self.skip_time_zone_conversion_for_attributes: () -> Array[untyped]
    %a{abstract}
    def self.time_zone_aware_types: () -> Array[Symbol]
    %a{abstract}
    def attributes_before_type_cast: () -> Hash[String, untyped]
    %a{abstract}
    def attributes: () -> Hash[String, untyped]
    %a{abstract}
    def readonly!: () -> untyped
    # default_scope (`lower::default_scope` emits the declaring model's).
    self.@_unscoped_depth: Integer?
    def self._default_scoped?: () -> bool
    def self._apply_default_scope: (Relation relation) -> Relation
    def self._apply_type_condition: (Relation relation) -> Relation
    def self._default_scope_attributes: () -> Hash[Symbol, untyped]
    def self._default_scope_applies?: () -> bool
    def self._type_conditioned?: () -> bool
    def self._join_scope_sql: () -> String
    def self.unscoped: () ?{ () -> untyped } -> untyped
    def _seed_default_scope_attributes: (Hash[Symbol, untyped] attrs) -> void
    def self.count: () -> Integer
    def self.last: () -> Base?
    def self.destroy_all: () -> Array[Base]
    def self.none: () -> Relation
    def self.page: (?(Integer | String | nil) num) -> Relation
    def self.in_batches: (?of: Integer, ?order: Symbol?) ?{ (Relation) -> void } -> Relation
    def self.paginate: (?(Integer | String | nil) num, ?page: (Integer | String | nil), ?per_page: (Integer | String | nil)) -> Relation
    def self.any?: () -> bool
    def self.none?: () -> bool
    def _attribute_snapshot: () -> Hash[String, untyped]
    def _note_hydrated: () -> void
    def _note_unloaded: (Hash[String, untyped] row) -> nil
    def has_attribute?: (String | Symbol attr_name) -> bool
    def _has_attribute?: (untyped attr_name) -> bool
    def read_attribute_before_type_cast: (String | Symbol attr_name) -> untyped
    def attributes_for_database: () -> Hash[String, untyped]
    def slice: (*untyped methods) -> untyped
    def values_at: (*untyped methods) -> Array[untyped]
    def self.has_attribute?: (String | Symbol attr_name) -> bool
    def self._has_attribute?: (untyped attr_name) -> bool
    %a{abstract}
    def self.reflect_on_all_associations: (?Symbol? macro) -> Array[untyped]
    %a{abstract}
    def self.reflections: () -> Hash[String, untyped]
    %a{abstract}
    def self.normalized_reflections: () -> Hash[Symbol, untyped]
    def attribute_previously_was: (String | Symbol name) -> untyped
    def self.first: () -> Base?
    def self.take: () -> Base?
    def self._hydrate_all: (String sql) -> Array[Base]
    def update_attribute: (Symbol name, untyped value) -> bool
    def valid?: (?Symbol? context) -> bool
    def validation_context: () -> Symbol?
    def validates_with: (*untyped args) ?{ (untyped, untyped, untyped) -> untyped } -> nil
    def save: (?context: Symbol?) -> bool
    def save!: (?context: Symbol?) -> Base
    # Ruby-family overrides of base.rb's dirty-tracking stubs.
    def __track_saved_changes: (bool was_new) -> void
    def saved_changes: () -> Hash[String, untyped]
    def previous_changes: () -> Hash[String, untyped]
    def changes_to_save: () -> Hash[String, untyped]
    def attribute_was: (String | Symbol name) -> untyped
    def saved_changes?: () -> bool
    def saved_change_to_attribute?: (String | Symbol attr_name, **untyped options) -> bool
    def saved_change_to_attribute: (String | Symbol attr_name) -> untyped
    def attribute_before_last_save: (String | Symbol attr_name) -> untyped
    def attribute_previously_changed?: (String | Symbol attr_name, **untyped options) -> bool
    def attribute_previous_change: (String | Symbol attr_name) -> untyped
    def will_save_change_to_attribute?: (String | Symbol attr_name, **untyped options) -> bool
    def attribute_changed?: (String | Symbol attr_name, **untyped options) -> bool
    def attribute_change_to_be_saved: (String | Symbol attr_name) -> untyped
    def attribute_change: (String | Symbol attr_name) -> untyped
    def attribute_in_database: (String | Symbol attr_name) -> untyped
    def changed_attribute_names_to_save: () -> Array[String]
    def changed: () -> Array[String]
    def changes: () -> Hash[String, untyped]
    def changed_attributes: () -> Hash[String, untyped]
    def attributes_in_database: () -> Hash[String, untyped]
    def restore_attributes: (?Array[String | Symbol] attr_names) -> untyped
    def restore_attribute!: (String | Symbol attr_name) -> untyped
    def clear_attribute_changes: (Array[String | Symbol] attr_names) -> untyped
    def clear_attribute_change: (String | Symbol attr_name) -> nil
    def changes_applied: () -> nil
    def _dirty_changed?: (Hash[String, untyped] changes, String | Symbol attr_name, Hash[Symbol, untyped] options) -> bool
    def _dirty_cast: (String attr_name, untyped value) -> untyped
    # Validations declared at run time (RuntimeValidations below).
    @marked_for_destruction: bool?
    def self.validate: (*untyped args) ?{ (?untyped) -> untyped } -> nil
    def self.validates: (*untyped attributes) -> nil
    def self.validates!: (*untyped attributes) -> nil
    def self.validates_with: (*untyped args) ?{ (untyped, untyped, untyped) -> untyped } -> nil
    def self.validates_each: (*untyped attr_names) { (untyped, untyped, untyped) -> untyped } -> nil
    def self.validates_absence_of: (*untyped attr_names) -> nil
    def self.validates_acceptance_of: (*untyped attr_names) -> nil
    def self.validates_associated: (*untyped attr_names) -> nil
    def self.validates_comparison_of: (*untyped attr_names) -> nil
    def self.validates_confirmation_of: (*untyped attr_names) -> nil
    def self.validates_exclusion_of: (*untyped attr_names) -> nil
    def self.validates_format_of: (*untyped attr_names) -> nil
    def self.validates_inclusion_of: (*untyped attr_names) -> nil
    def self.validates_length_of: (*untyped attr_names) -> nil
    def self.validates_size_of: (*untyped attr_names) -> nil
    def self.validates_numericality_of: (*untyped attr_names) -> nil
    def self.validates_presence_of: (*untyped attr_names) -> nil
    def self.validates_uniqueness_of: (*untyped attr_names) -> nil
    def self._validators: () -> Hash[untyped, Array[untyped]]
    def self.validators: () -> Array[untyped]
    def self.validators_on: (*untyped attributes) -> Array[untyped]
    def self.i18n_scope: () -> Symbol
    def self.lookup_ancestors: () -> Array[untyped]
    def self.human_attribute_name: (untyped attribute, ?Hash[Symbol, untyped] options) -> untyped
    def self.model_name: () -> untyped
    def model_name: () -> untyped
    def read_attribute_for_validation: (untyped attribute) -> untyped
    def self._reflect_on_association: (untyped association) -> untyped
    def marked_for_destruction?: () -> bool
    def errors: () -> Array[String]
    def _fresh_errors: () -> Array[String]
    def self._errors_reader_replaced?: () -> bool
  end

  # The validate chain for run-time registrations (connection.rb).
  module RuntimeValidations
    EMPTY: Array[untyped]
    COMPILED: ActiveRecord::RuntimeValidations::CompiledEntry
    self.@generation: Integer
    self.@context_predicates: Hash[Array[untyped], ActiveRecord::RuntimeValidations::OnContext]
    def self.validate: (untyped klass, Array[untyped] args, untyped block) -> nil
    def self.validates: (untyped klass, Array[untyped] attributes, bool strict) -> nil
    def self.validates_with: (untyped klass, Array[untyped] args, untyped block) -> nil
    def self.instance_validates_with: (untyped record, Array[untyped] args, untyped block) -> nil
    def self.validates_each: (untyped klass, Array[untyped] attr_names, untyped block) -> nil
    def self.helper: (untyped klass, String name, Array[untyped] attr_names) -> nil
    def self.validator_class: (untyped klass, String name) -> untyped
    def self.validator_namespaces: () -> Array[untyped]
    def self.validators_of: (untyped klass) -> Hash[untyped, Array[untyped]]
    def self.new_list: (Hash[untyped, Array[untyped]] hash, untyped key) -> Array[untyped]
    def self.all_validators: (untyped klass) -> Array[untyped]
    def self.validators_on: (untyped klass, Array[untyped] attributes) -> Array[untyped]
    def self.registrations: (untyped klass) -> Array[ActiveRecord::RuntimeValidations::Entry]
    def self.run: (untyped record) -> nil
    def self.chain: (untyped klass) -> Array[ActiveRecord::RuntimeValidations::Entry | ActiveRecord::RuntimeValidations::CompiledEntry]?
    def self.build: (untyped klass) -> Array[ActiveRecord::RuntimeValidations::Entry | ActiveRecord::RuntimeValidations::CompiledEntry]?
    def self.apply: (Array[ActiveRecord::RuntimeValidations::Entry | ActiveRecord::RuntimeValidations::CompiledEntry] chain, ActiveRecord::RuntimeValidations::Entry entry) -> nil
    def self.compiled_owner: (untyped klass) -> untyped
    def self.lookup_ancestors: (untyped klass) -> Array[untyped]
    def self.human_attribute_name: (untyped klass, untyped attribute, untyped options) -> untyped
    def self.model_name: (untyped klass) -> untyped
    def self.read_attribute: (untyped record, untyped attribute) -> untyped
    def self.reflect_on_association: (untyped klass, untyped association) -> untyped
    def self.extract_options!: (Array[untyped] args) -> Hash[Symbol, untyped]
    def self.conditionals: (untyped value) -> Array[untyped]
    def self.context_predicate: (untyped context) -> ActiveRecord::RuntimeValidations::OnContext
    def self.merge_attributes: (Array[untyped] attr_names) -> Hash[untyped, untyped]
    def self.parse_validates_options: (untyped options) -> Hash[Symbol, untyped]
    def self.merge_validates_options: (Hash[Symbol, untyped] defaults, Hash[Symbol, untyped] validator_options) -> Hash[untyped, untyped]
    def self.port!: (String port, String what) -> nil
    def self.accumulator: (Array[String] errors, untyped record) -> Array[String]
    def self.plain_array?: (untyped value) -> bool
    def self.add_error: (untyped errors, untyped attribute, untyped type, Hash[Symbol, untyped] options) -> untyped

    module Errors
      def add: (untyped attribute, ?untyped type, **untyped options) -> untyped
      def full_messages: () -> Array[String]
    end

    class Entry
      @filter: untyped
      @if: Array[untyped]
      @unless: Array[untyped]
      @prepend: bool
      def initialize: (untyped filter, Array[untyped] if_conditions, Array[untyped] unless_conditions, bool prepend) -> void
      def filter: () -> untyped
      def prepend?: () -> bool
      def compiled?: () -> bool
      def duplicates?: (untyped other) -> bool
      def run: (untyped record) -> nil
      def self.call: (untyped filter, untyped record) -> untyped
    end

    class OnContext
      @contexts: Array[untyped]
      def initialize: (Array[untyped] contexts) -> void
      def validate: (untyped record) -> bool
    end

    class ExceptOnContext
      @contexts: Array[untyped]
      def initialize: (Array[untyped] contexts) -> void
      def validate: (untyped record) -> bool
    end

    class CompiledEntry
      def filter: () -> nil
      def prepend?: () -> bool
      def compiled?: () -> bool
      def duplicates?: (untyped _other) -> bool
      def run: (untyped record) -> nil
    end
  end

  # The bulk-write entry points on Relation (see the end of connection.rb).
  class Relation
    @model: Base
    def insert_all: (Array[Hash[Symbol, untyped]] rows, ?unique_by: (String | Symbol | Array[Symbol])?, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def insert_all!: (Array[Hash[Symbol, untyped]] rows, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def insert: (Hash[Symbol, untyped] attrs, ?unique_by: (String | Symbol | Array[Symbol])?, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def insert!: (Hash[Symbol, untyped] attrs, ?returning: untyped, ?record_timestamps: bool?) -> Integer
    def upsert_all: (Array[Hash[Symbol, untyped]] rows, ?unique_by: (String | Symbol | Array[Symbol])?, ?on_duplicate: String?, ?update_only: (String | Symbol | Array[Symbol | String])?, ?returning: untyped) -> Integer
    def upsert: (Hash[Symbol, untyped] attrs, ?unique_by: (String | Symbol | Array[Symbol])?, ?on_duplicate: String?, ?update_only: (String | Symbol | Array[Symbol | String])?, ?returning: untyped) -> Integer
  end
end
