module ActiveRecord
  # Raised by `Base.find` when no row matches the given id.
  class RecordNotFound < StandardError
    def initialize: (?String message) -> void
  end

  # Raised for a statement the database refused; the parent of the
  # statement errors below, as in Rails.
  class StatementInvalid < StandardError
    def initialize: (?String message) -> void
  end

  # Raised when a value exceeds its column's declared limit.
  class ValueTooLong < StatementInvalid
    def initialize: (?String message) -> void
  end

  # Raised when an INSERT/UPDATE trips a unique index; each `Db` raises
  # it (see the .rb).
  class RecordNotUnique < StatementInvalid
    def initialize: (?String message) -> void
  end

  # Raised by `Base#save!` when validation fails. `record` is the
  # invalid model; `attr_reader :record` lowers to a getter at ingest.
  class RecordInvalid < StandardError
    def record: () -> Base
    def initialize: (Base record) -> void
  end
end
