module Arel
  class BindError < StandardError
  end

  def self.sql: (String fragment, *(Arel::Nodes::Node | String | Integer | Float | bool | nil) positional, **(Arel::Nodes::Node | String | Integer | Float | bool | nil) named) -> Arel::Nodes::SqlLiteral

  def self.star: () -> String

  class SelectManager
    @sql: String

    def initialize: (String sql) -> void

    def to_sql: () -> String

    def exists: () -> String
  end

  class Table
    @name: String

    # `attr_reader :name` lowers to a getter at ingest (same shape as
    # RecordInvalid#record in errors.rbs).
    def name: () -> String

    def initialize: (String name) -> void

    def attribute: (String | Symbol column) -> Arel::Attribute

    def project: (String | Symbol column) -> String
  end

  class Attribute
    @qualified: String

    def initialize: (String qualified) -> void

    def to_s: () -> String

    def in: (ActiveRecord::Relation | SelectManager subquery) -> String

    def not_in: (ActiveRecord::Relation | SelectManager subquery) -> String
  end

  module Nodes
    def self.embed: (Arel::Nodes::Node | String | Integer | Float | bool | nil value) -> String
    def self.quote_scalar: (String | Integer | Float | bool | nil value) -> String
    def self.build_quoted: (String | Integer | Float | bool | nil value) -> Quoted
    def self.replace_question: (String text, String literal) -> String
    def self.replace_questions: (String text, Array[String] literals) -> String
    def self.replace_named: (String text, String key, String literal) -> String
    def self.name_boundary?: (String? ch) -> bool
    def self.count_questions: (String text) -> Integer
    def self.unbound_name: (String text) -> String?
    def self.name_start?: (String? ch) -> bool

    class Node
      def to_s: () -> String
      def to_sql: () -> String
    end

    class NodeExpression < Node
    end

    class Unary < NodeExpression
      @expr: untyped

      def expr: () -> untyped

      def initialize: (untyped expr) -> void
    end

    class Grouping < Unary
      # Unary's reader, redeclared where the body typer sees no superclass.
      %a{abstract}
      def expr: () -> untyped

      def to_sql: () -> String

      def to_s: () -> String
    end

    class BoundSqlLiteral < NodeExpression
      @sql_with_placeholders: String
      @positional_binds: Array[untyped]
      @named_binds: Hash[Symbol, untyped]

      def sql_with_placeholders: () -> String

      def positional_binds: () -> Array[untyped]

      def named_binds: () -> Hash[Symbol, untyped]

      def initialize: (String sql_with_placeholders, Array[untyped] positional_binds, Hash[Symbol, untyped] named_binds) -> void

      def to_s: () -> String
    end

    class SqlLiteral < Node
      @sql: String
      def initialize: (String sql) -> void
      def to_s: () -> String
    end

    class Quoted < Node
      @sql: String
      def initialize: (String sql) -> void
      def to_s: () -> String
    end

    class Not < Node
      @expr: String
      def initialize: (String | Arel::Nodes::Node expr) -> void
      def to_s: () -> String
    end

    class Case < Node
      @predicates: Array[String?]
      @results: Array[String]
      @pending: String?
      @fallback: String?
      def initialize: () -> void
      def when: (String | Arel::Nodes::Node predicate) -> self
      def then: (String | Integer | Float | Arel::Nodes::Node | nil value) -> self
      def else: (String | Integer | Float | Arel::Nodes::Node | nil value) -> self
      def self.fragment: (String | Integer | Float | Arel::Nodes::Node | nil value) -> String
      def to_s: () -> String
    end

    class NamedFunction < Node
      @name: String
      @exprs: Array[String]
      def initialize: (String | Symbol name, Array[String | Arel::Nodes::Node] exprs) -> void
      def to_s: () -> String
    end
  end
end

module ActiveRecord
  class Base
    def self.arel_table: () -> Arel::Table
  end
end
