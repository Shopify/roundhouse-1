module ActionController
  class UnfilteredParameters < ArgumentError
    def initialize: () -> void
  end

  class InvalidParameterKey < ArgumentError
  end

  class ExpectedParameterMissing < ParameterMissing
  end

  class UnpermittedParameters < StandardError
    @params: Array[String]
    def initialize: (Array[String] params) -> void
    def params: () -> Array[String]
  end

  # A parameter value is any Ruby object (`::Object`): scalars, nested
  # Parameters, arrays of either, or what a caller stored.
  class Parameters
    @parameters: Hash[String, ::Object]
    @logging_context: Hash[Symbol, untyped]
    @permitted: bool
    self.@permit_all_parameters: bool?
    self.@action_on_unpermitted_parameters: (Symbol | bool)?
    self.@action_on_unpermitted_parameters_set: bool?
    self.@always_permitted_parameters: Array[String]?

    def self.permit_all_parameters: () -> bool
    def self.permit_all_parameters=: (bool value) -> bool
    def self.action_on_unpermitted_parameters: () -> (Symbol | bool)?
    def self.action_on_unpermitted_parameters=: ((Symbol | bool)? value) -> (Symbol | bool)?
    def self.always_permitted_parameters: () -> Array[String]
    def self.always_permitted_parameters=: (Array[String] value) -> Array[String]
    def self.nested_attribute?: (::Object key, ::Object value) -> bool
    def self.convert_key: (::Object key) -> String
    def self.convert_value: (::Object value) -> ::Object
    def self.indifferent: (Hash[String, ::Object] hash) -> Hash[String, ::Object]
    def self.permit_nested!: (::Object value) -> ::Object
    def self.checked: (Hash[untyped, untyped] parameters) -> Hash[untyped, untyped]
    def self.check_key: (::Object key) -> void
    def self.hash_like: (::Object parameters) -> Hash[untyped, untyped]
    def self.hook_into_yaml_loading: () -> void
    def self.store_of: (::Object map) -> Hash[String, ::Object]
    def self.hash_of: (::Object other) -> Hash[::Object, ::Object]
    def self.update_store: (Hash[String, ::Object] store, Hash[::Object, ::Object] other, (^(String, ::Object, ::Object) -> ::Object)? block) -> Hash[String, ::Object]
    def self.deep_dup_value: (::Object value) -> ::Object
    def self.blank?: (::Object value) -> bool
    def self.present?: (::Object value) -> bool
    def self.permitted_scalar?: (::Object value) -> bool
    def self.wrap: (::Object object) -> Array[::Object]

    def initialize: (?::Object parameters, ?Hash[Symbol, untyped] logging_context) -> void
    def parameters: () -> Hash[String, ::Object]
    def permitted=: (bool value) -> bool
    def ==: (::Object other) -> bool
    def eql?: (::Object other) -> bool
    def hash: () -> Integer
    def deconstruct_keys: (Array[::Object]? keys) -> Hash[Symbol, ::Object]
    def keys: () -> Array[String]
    def empty?: () -> bool
    def include?: (::Object key) -> bool
    def has_key?: (::Object key) -> bool
    def key?: (::Object key) -> bool
    def member?: (::Object key) -> bool
    def exclude?: (::Object key) -> bool
    def each_key: () { (String) -> void } -> Parameters
    def to_s: () -> String
    def as_json: (?::Object options) -> ::Object
    def to_h: () ?{ (String, ::Object) -> ::Object } -> Hash[String, ::Object]
    def to_hash: () -> Hash[String, ::Object]
    def to_query: (*untyped args) -> String
    def to_param: (*untyped args) -> String
    def to_unsafe_h: () -> Hash[String, ::Object]
    def to_unsafe_hash: () -> Hash[String, ::Object]
    def each_pair: () { (Array[::Object]) -> void } -> Parameters
    def each: () { (Array[::Object]) -> void } -> Parameters
    def each_value: () { (::Object) -> void } -> Parameters
    def values: () -> Array[::Object]
    def permitted?: () -> bool
    def permit!: () -> Parameters
    def require: (::Object key) -> ::Object
    def required: (::Object key) -> ::Object
    def permit: (*::Object filters) -> Parameters
    def expect: (*::Object filters) -> ::Object
    def expect!: (*::Object filters) -> ::Object
    def []: (::Object key) -> ::Object
    def []=: (::Object key, ::Object value) -> ::Object
    def fetch: (::Object key, *::Object args) ?{ (::Object) -> ::Object } -> ::Object
    def fetch_values: (*::Object keys) ?{ (::Object) -> ::Object } -> Array[::Object]
    def dig: (*::Object keys) -> ::Object
    def slice: (*::Object keys) -> Parameters
    def slice!: (*::Object keys) -> Parameters
    def except: (*::Object keys) -> Parameters
    def without: (*::Object keys) -> Parameters
    def extract!: (*::Object keys) -> Parameters
    def transform_values: () { (::Object) -> ::Object } -> Parameters
    def transform_values!: () { (::Object) -> ::Object } -> Parameters
    def transform_keys: () { (String) -> ::Object } -> Parameters
    def transform_keys!: () { (String) -> ::Object } -> Parameters
    def deep_transform_keys: () -> Parameters
    def deep_transform_keys!: () -> Parameters
    def deep_transform_values: () -> Parameters
    def deep_transform_values!: () -> Parameters
    def deep_merge: (::Object _other) -> Parameters
    def deep_merge!: (::Object _other) -> Parameters
    def delete: (::Object key) ?{ (String) -> ::Object } -> ::Object
    def select: () { (String, ::Object) -> ::Object } -> Parameters
    def select!: () { (String, ::Object) -> ::Object } -> Parameters
    def keep_if: () { (String, ::Object) -> ::Object } -> Parameters
    def reject: () { (String, ::Object) -> ::Object } -> Parameters
    def reject!: () { (String, ::Object) -> ::Object } -> Parameters
    def delete_if: () { (String, ::Object) -> ::Object } -> Parameters
    def compact: () -> Parameters
    def compact!: () -> Parameters?
    def compact_blank: () -> Parameters
    def compact_blank!: () -> Parameters
    def has_value?: (::Object value) -> bool
    def value?: (::Object value) -> bool
    def values_at: (*::Object keys) -> Array[::Object]
    def merge: (*::Object other_hashes) ?{ (String, ::Object, ::Object) -> ::Object } -> Parameters
    def merge!: (*::Object other_hashes) ?{ (String, ::Object, ::Object) -> ::Object } -> Parameters
    def reverse_merge: (::Object other_hash) -> Parameters
    def with_defaults: (::Object other_hash) -> Parameters
    def reverse_merge!: (::Object other_hash) -> Parameters
    def with_defaults!: (::Object other_hash) -> Parameters
    def stringify_keys: () -> Parameters
    def inspect: () -> String
    def init_with: (untyped coder) -> void
    def encode_with: (untyped coder) -> void
    def dup: () -> Parameters
    def deep_dup: () -> Parameters
    def extract_value: (::Object key, ?delimiter: String) -> Array[String]?
    def replace_store: (Hash[String, ::Object] store) -> Hash[String, ::Object]
    def nested_attributes?: () -> bool
    def permit_nested_attributes: (::Object filter, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> Parameters
    def permit_filters: (Array[::Object] filters, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> Parameters

    private

    def store_slice: (Array[::Object] keys) -> Hash[String, ::Object]
    def new_instance_with_inherited_permitted_status: (Hash[String, ::Object] hash) -> Parameters
    def convert_parameters_to_hashes: (::Object value, bool unsafe) ?{ (String, ::Object) -> ::Object } -> ::Object
    def convert_hashes_to_parameters: (String key, ::Object value) -> ::Object
    def convert_value_to_parameters: (::Object value) -> ::Object
    def specify_numeric_keys?: (::Object filter) -> bool
    def array_filter?: (::Object filter) -> bool
    def unpermitted_parameters!: (Parameters params, ?on_unpermitted: (Symbol | bool)?) -> void
    def unpermitted_keys: (Parameters params) -> Array[String]
    def permitted_scalar_filter: (Parameters params, ::Object permitted_key) -> void
    def non_scalar?: (::Object value) -> bool
    def hash_filter: (Parameters params, Hash[::Object, ::Object] filter, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> void
    def permit_value: (::Object value, ::Object filter, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> ::Object
    def permit_array_of_scalars: (::Object value) -> Array[::Object]?
    def permit_array_of_hashes: (::Object value, ::Object filter, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> ::Object
    def permit_hash: (::Object value, ::Object filter, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> Parameters?
    def permit_hash_or_array: (::Object value, ::Object filter, (Symbol | bool)? on_unpermitted, bool explicit_arrays) -> ::Object
    def permit_any_in_parameters: (Parameters params) -> Parameters
    def permit_any_in_array: (Array[::Object] array) -> Array[::Object]
  end
end
