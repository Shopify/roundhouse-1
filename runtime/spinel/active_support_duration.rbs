# Pins @seconds (and every unit constructor's n) to Integer so the
# temporal arithmetic in ago/from_now stays Time-typed under AOT
# inference — an untyped @seconds widens `Time.now.utc - @seconds` to
# poly, which the declared Time return then contradicts. Corpus units
# are integral (45, minutes(5), 70.days); fractional durations would
# need a widening here first.
module ActiveSupport
  class Duration
    @seconds: Integer
    @parts: Array[Integer?]
    @order: Array[Integer]

    PART_NAMES: Array[String]

    def initialize: (Integer seconds, ?Array[Integer?]? parts, ?Array[Integer]? order) -> void
    def self.present_slots: (Array[Integer?] parts) -> Array[Integer]
    def self.single_part: (Integer index, Integer n) -> Array[Integer?]
    def self.seconds: (Integer n) -> Duration
    def self.second: (Integer n) -> Duration
    def self.minutes: (Integer n) -> Duration
    def self.minute: (Integer n) -> Duration
    def self.hours: (Integer n) -> Duration
    def self.hour: (Integer n) -> Duration
    def self.days: (Integer n) -> Duration
    def self.day: (Integer n) -> Duration
    def self.weeks: (Integer n) -> Duration
    def self.week: (Integer n) -> Duration
    def self.fortnights: (Integer n) -> Duration
    def self.fortnight: (Integer n) -> Duration
    def self.months: (Integer n) -> Duration
    def self.month: (Integer n) -> Duration
    def self.years: (Integer n) -> Duration
    def self.year: (Integer n) -> Duration
    def ago: (?Time time) -> Time
    def until: (?Time time) -> Time
    def before: (?Time time) -> Time
    def from_now: (?Time time) -> Time
    def since: (?Time time) -> Time
    def after: (?Time time) -> Time
    def sum: (Integer sign, untyped time) -> untyped
    def self.move_seconds: (untyped time, untyped seconds, bool date) -> untyped
    def self.advance_date: (untyped date, Integer index, untyped n) -> untyped
    def self.advance_time: (Time time, Integer index, untyped n) -> Time
    def self.change_date: (Time time, Integer year, Integer month, Integer day) -> Time
    def self.days_in_month: (Integer year, Integer month) -> Integer
    def self.civil_to_jd: (Integer year, Integer month, Integer day) -> Integer
    def self.jd_to_civil: (Integer jd) -> Array[Integer]
    def to_i: () -> Integer
    def to_f: () -> Float
    def in_seconds: () -> Integer
    def in_minutes: () -> Float
    def in_hours: () -> Float
    def in_days: () -> Float
    def in_weeks: () -> Float
    def in_months: () -> Float
    def in_years: () -> Float
    def to_s: () -> String
    def seconds: () -> Integer
    def part_slots: () -> Array[Integer?]
    def part_order: () -> Array[Integer]
    def +: (untyped other) -> Duration
    def -: (untyped other) -> Duration
    def -@: () -> Duration
    def +@: () -> Duration
    def *: (untyped other) -> Duration
    # A Duration by a number, or a plain number for Duration / Duration.
    def /: (untyped other) -> untyped
    def inspect: () -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def is_a?: (untyped klass) -> bool
    def kind_of?: (untyped klass) -> bool
    def instance_of?: (untyped klass) -> bool
    def self.===: (untyped other) -> bool
    def hash: () -> Integer
    def <=>: (untyped other) -> Integer?
    def self.value_of: (untyped other) -> untyped
    def coerce: (untyped other) -> [untyped, Integer]
    def <: (untyped other) -> bool
    def <=: (untyped other) -> bool
    def >: (untyped other) -> bool
    def >=: (untyped other) -> bool
  end
end
